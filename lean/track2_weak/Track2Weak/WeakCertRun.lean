theorem concreteChain : Chain certRows [Int.ofNat wdScale] 1 0 0 success12 weightedCost21 := by
  unfold certRows
  apply Chain.cons rowOk0 rfl rfl
  apply Chain.cons rowOk1 rfl rfl
  apply Chain.cons rowOk2 rfl rfl
  apply Chain.cons rowOk3 rfl rfl
  apply Chain.cons rowOk4 rfl rfl
