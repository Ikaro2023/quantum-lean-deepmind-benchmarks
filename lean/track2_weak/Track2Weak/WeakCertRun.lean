  apply Chain.cons rowOk18 rfl rfl
  apply Chain.cons rowOk19 rfl rfl
  apply Chain.cons rowOk20 rfl rfl
  apply Chain.cons rowOk21 rfl rfl
  apply Chain.cons rowOk22 rfl rfl
  apply Chain.cons rowOk23 rfl rfl
  exact Chain.nil

theorem concreteOrbit {n : Nat} (hn : 80000 ≤ n) :
    let attempt := runOrbit n certRows (u0OrbVecGen (2^n) 1024 512)
    vecSqNorm attempt.1 ≤ 1 - success12 / (oneT:ℝ) ∧
      attempt.2 ≤ weightedCost21 / ((oneB:ℝ)*oneT) := by
  have he : vecNorm (Sub.sub (α:=V) (u0OrbVecGen (2^n) 1024 512)
      (rkmListToOrbVec 512 [Int.ofNat wdScale])) ≤ ((1:Nat):ℝ)/wdScaleR := by
    simpa only [Nat.cast_one] using initialError hn
  simpa using concreteChain.sound hn he (initialMass hn)

