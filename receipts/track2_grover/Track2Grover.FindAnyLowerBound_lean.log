@finite : ∀ {n m k w : ℕ} (C : OracleDynamicCircuit (Unitary (2 ^ w)) Grover.Var w ((n + 1) * m)),
  0 < m →
    0 < k →
      k ≤ 2 ^ n →
        (∀ S ∈ groverTargetSets n k,
            ⦃ ⊤ ⦄ QProg.qSet.qSeq (OracleDynamicCircuit.compile QProg.qAssign (groverParallelMarkingOracle m S) C) ⦃
              fun σ => ⌜∃ x ∈ S, σ Grover.Var.res = ↑↑x⌝ ⦄) →
          ∀ {q : ℝ},
            AvgOracleCostBound k (fun S => CostModel.ofEmbeddedOracle (groverParallelMarkingOracle m S))
                (fun S =>
                  QProg.qSet.qSeq (OracleDynamicCircuit.compile QProg.qAssign (groverParallelMarkingOracle m S) C))
                q →
              (π / 4 + 1 / 2) * (1 - ↑k / 2 ^ n) / (2 * arcsin √(↑m * ↑k / 2 ^ n)) ≤ q
@actual_expected_rounds : ∀ {n m k w : ℕ} (C : OracleDynamicCircuit (Unitary (2 ^ w)) Grover.Var w ((n + 1) * m)),
  0 < m →
    0 < k →
      k ≤ 2 ^ n →
        Lower.Correct C k →
          ∀ (σ : Store Grover.Var),
            ENNReal.ofReal ((π / 4 + 1 / 2) * (1 - ↑k / 2 ^ n) / (2 * arcsin √(↑m * ↑k / 2 ^ n))) ≤
              (∑ S ∈ groverTargetSets n k,
                  expectedCost (CostModel.ofEmbeddedOracle (groverParallelMarkingOracle m S))
                    (QProg.qSet.qSeq (OracleDynamicCircuit.compile QProg.qAssign (groverParallelMarkingOracle m S) C))
                    (Path.seed w σ)) /
                ↑(groverTargetSets n k).card
