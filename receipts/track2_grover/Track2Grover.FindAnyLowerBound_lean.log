@no_smaller_rational : ∀ {m k : ℕ}, 0 < m → 0 < k → ∀ (R : ℚ≥0), ↑R < 1 / 2 + 1 / π → ¬Feasible m k ↑R
@exact_infimum : ∀ {m k : ℕ}, m ∈ groverGrid → k ∈ groverGrid → IsGLB {R | Feasible m k R} (1 / 2 + 1 / π)
